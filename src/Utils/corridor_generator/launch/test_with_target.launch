<launch>
  <!-- 测试目标发布节点 -->
  <node pkg="corridor_generator" type="test_target_publisher" name="test_target_publisher" output="screen">
    <!-- 发布频率 (Hz) -->
    <param name="publish_rate" value="1.0" type="double"/>
    
    <!-- 目标位置 -->
    <param name="target_x" value="8.0" type="double"/>
    <param name="target_y" value="2.5" type="double"/>
    <param name="target_z" value="1.0" type="double"/>
    
    <!-- 目标3D框大小 -->
    <param name="target_size_x" value="1.0" type="double"/>
    <param name="target_size_y" value="1.0" type="double"/>
    <param name="target_size_z" value="2.0" type="double"/>
  </node>

  <!-- 飞行走廊生成器节点 -->
  <node pkg="corridor_generator" type="corridor_generator_node" name="corridor_generator" output="screen">
    <!-- 走廊参数 -->
    <param name="corridor_radius" value="1.5" type="double"/>
    
    <!-- 局部边界框大小 (相对于种子点的半边长) -->
    <param name="local_bbox_x" value="5.0" type="double"/>
    <param name="local_bbox_y" value="5.0" type="double"/>
    <param name="local_bbox_z" value="3.0" type="double"/>
    
    <!-- 障碍物搜索半径 -->
    <param name="obstacle_search_radius" value="15.0" type="double"/>
    
    <!-- 最小地面高度：限制飞行走廊不低于此高度（更符合真实无人机运动） -->
    <param name="min_ground_height" value="0.0" type="double"/>
    
    <!-- 目标框膨胀量：处理点云时额外移除目标框周围的点，提供安全裕度 -->
    <param name="target_bbox_padding" value="0.5" type="double"/>
    
    <!-- 订阅点云话题 -->
    <remap from="/map_ros/cloud" to="/sdf_map/occupancy_all"/>
  </node>

  <!-- RViz 可视化（可选，取消注释以启用） -->
  <!-- <node pkg="rviz" type="rviz" name="corridor_test_rviz" args="-d $(find corridor_generator)/launch/corridor_generator.rviz" required="false"/> -->

</launch>

